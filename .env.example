# === Deployment mode ===
# online  = real Gemini API calls (requires GEMINI_API_KEY)
# offline = canned responses, no network (for local dev / CI)
ARCHY_MODE=online

# === Server ===
ARCHY_HOST=127.0.0.1
ARCHY_PORT=8000

# === Database ===
# Desktop (default): SQLite at this path. Zero-config.
ARCHY_DB_PATH=~/.archy/archy.db

# Web deployment: set ARCHY_DB_URL to a PostgreSQL connection string.
# When set, this takes priority over ARCHY_DB_PATH.
# Get a free one from https://neon.tech — format:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
ARCHY_DB_URL=

# === CORS (web deployment only) ===
# Comma-separated list of allowed origins. Use "*" for desktop/permissive.
# For production web deployment, set to your Vercel URL:
#   ARCHY_ALLOWED_ORIGINS=https://archy.vercel.app,https://www.archy.vercel.app
ARCHY_ALLOWED_ORIGINS=*

# === Auth (web deployment) ===
# Secret key for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARCHY_SECRET_KEY=dev-secret-change-me

# Frontend URL — where to redirect after Google OAuth completes.
# Desktop dev: http://localhost:5173
# Production:  https://archy.vercel.app
ARCHY_FRONTEND_URL=http://localhost:5173

# When true, all endpoints (except /health, /keep-alive, /auth/*) require
# login. Set to true for web deployment, false for desktop.
ARCHY_REQUIRE_AUTH=false

# === Gemini API ===
GEMINI_API_KEY=your-key-from-https://aistudio.google.com/apikey

ARCHY_LLM_MODEL=gemini-2.5-flash
ARCHY_LLM_MODEL_PREMIUM=gemini-2.5-pro
ARCHY_EMBEDDING_MODEL=gemini-embedding-001
ARCHY_LIGHT_MODEL=gemma-3-27b-it
ARCHY_TTS_MODEL=gemini-2.5-flash-preview-tts
ARCHY_LIVE_STT_MODEL=gemini-2.5-flash-native-audio-dialog

ARCHY_LLM_THINKING_BUDGET=0
ARCHY_ROUTER_COMPLEXITY_THRESHOLD=80
ARCHY_ROUTER_LIGHT_THRESHOLD=30

ARCHY_BUFFER_MINUTES=5
ARCHY_WORKDAY_START=09:00
ARCHY_WORKDAY_END=22:00
ARCHY_MOOD_BASELINE=75
ARCHY_MOOD_MIN=0
ARCHY_MOOD_MAX=100
ARCHY_RELEVANCY_THRESHOLD=65
ARCHY_MAX_NEGOTIATION_ROUNDS=2

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ARCHY_CALENDAR_SYNC_ENABLED=false
ARCHY_CALENDAR_ID=primary
ARCHY_DAILY_BRIEF_ENABLED=false
