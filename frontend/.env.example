# Archy frontend environment variables.
# Copy to `.env` or `.env.local` for local dev, or set in the Vercel dashboard.

# ───────────────────────────────────────────────────────────────────────────
# HTTP API base URL.
# - Local dev:    http://127.0.0.1:8000  (default if unset)
# - Vercel prod:  leave UNSET — the app uses same-origin /api by default,
#                 and vercel.json rewrites /api/* to the backend host.
# - Cross-origin: set to your backend URL (e.g. https://archy-backend.onrender.com)
#                 if you don't want to use the /api rewrite. Backend must allow
#                 your origin via ARCHY_ALLOWED_ORIGINS.
# This is read at BUILD time by Vite (must be prefixed with VITE_).
# ───────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ───────────────────────────────────────────────────────────────────────────
# WebSocket base URL (required for Vercel deployments).
# Vercel's edge rewrites can't proxy WebSocket upgrades, so the frontend
# connects to the backend directly for live events. Set this to your
# Render backend's wss:// URL.
# ───────────────────────────────────────────────────────────────────────────
# VITE_WS_BASE_URL=wss://archy-backend.onrender.com
