# Archy frontend environment variables.
# Copy to `.env` or `.env.local` for local dev, or set in the Vercel dashboard.

# Backend API base URL.
# - Local dev:    http://127.0.0.1:8000  (default if unset)
# - Vercel prod:  https://your-render-backend.onrender.com
#
# This is read at BUILD time by Vite (must be prefixed with VITE_).
# WebSocket URL is derived automatically (http→ws, https→wss).
VITE_API_BASE_URL=http://127.0.0.1:8000
